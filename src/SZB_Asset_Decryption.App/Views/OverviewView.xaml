<UserControl x:Class="SzbAssetDecryption.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SzbAssetDecryption.App.Services"
             xmlns:ctl="clr-namespace:SzbAssetDecryption.App.Controls"
             x:Name="Root">
    <Grid Margin="26,4,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="196" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,4">
                <TextBlock Text="概览" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,7,0,0"
                           Text="这个工具只做两件事：把加密层去掉，把容器拆开。它不做反编译，也不把资源导入引擎。先指定两个目录，然后就可以开始。" />

                <!-- ============ 目录 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="一、指定目录" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,5,0,16"
                                   Text="数据目录是游戏里的 Persistent/dat，里面按哈希命名的文件就是全部素材。输出目录用来放还原结果，建议放在磁盘空间充足的分区。" />

                        <TextBlock Text="游戏数据目录（Persistent/dat）" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DatBox" Style="{StaticResource Input}"
                                     Text="{Binding DatRoot, Source={x:Static svc:Workspace.Current}, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="BrowseDat_Click" />
                        </Grid>

                        <TextBlock Text="输出目录" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding OutputRoot, Source={x:Static svc:Workspace.Current}, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ManifestDot" Width="7" Height="7" Fill="{StaticResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ManifestText" Grid.Column="1" Style="{StaticResource Caption}"
                                       Text="{Binding ManifestStatus, Source={x:Static svc:Workspace.Current}}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="重新读取清单" Style="{StaticResource GhostButton}"
                                    Click="ReloadManifest_Click" />
                        </Grid>

                        <Border x:Name="DepBar" Style="{StaticResource WarnBar}" Visibility="Collapsed">
                            <TextBlock x:Name="DepText" Style="{StaticResource Body}" FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ 体检 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="二、整体体检" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,5,0,0" MaxWidth="620"
                                           HorizontalAlignment="Left"
                                           Text="逐个文件读文件头，统计类型、压缩方式、数据起点，并校验包结构是否自洽。它不写任何文件，跑完只用几秒，建议每次动手前先跑一遍。" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="CancelCensus" Content="取消" Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed" Click="CancelCensus_Click" />
                                <Button x:Name="RunCensus" Content="开始体检" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="RunCensus_Click" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="CensusBar" Style="{StaticResource Bar}" Margin="0,16,0,0" Value="0" />

                        <ItemsControl x:Name="StatList" ItemsSource="{Binding Stats, ElementName=Root}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="13,10" Margin="0,0,8,8" Width="138">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="KindBox" Style="{StaticResource Divider}" Visibility="Collapsed" />
                        <TextBlock x:Name="KindTitle" Text="文件类型构成" Style="{StaticResource FieldLabel}"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="KindList" ItemsSource="{Binding Kinds, ElementName=Root}"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Style="{StaticResource Body}" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hint}"
                                                   Style="{StaticResource Caption}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ctl:LogPanel Grid.Row="1" />
    </Grid>
</UserControl>
