<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SZB_Asset_Decryption</AssemblyName>
    <RootNamespace>SzbAssetDecryption.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.2</Version>
    <Product>SZB Asset Decryption</Product>
    <AssemblyTitle>SZB Asset Decryption</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SZB_Asset_Decryption.Core\SZB_Asset_Decryption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependencies 是 exe 旁边优先级最高的搜索目录（见 ToolLocator）。
         README 说明放什么；放进去的 ffmpeg / vgmstream 要跟着发布出去，
         否则发布目录里只剩一份说明，程序还得去 PATH 里找。 -->
    <None Update="Dependencies\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
