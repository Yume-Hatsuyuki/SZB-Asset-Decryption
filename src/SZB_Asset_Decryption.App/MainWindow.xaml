<Window x:Class="SzbAssetDecryption.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SzbAssetDecryption.App.Views"
        Title="SZB Asset Decryption" Height="812" Width="1232"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBase}" BorderBrush="#1B2333" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= 侧边栏 ======================= -->
            <Border Grid.Column="0" Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,16,20">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#1B2740"
                                BorderBrush="#2E4270" BorderThickness="1">
                            <TextBlock Text="S" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SZB Asset Decryption" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="资源还原工作台" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="工作区" Style="{StaticResource Caption}"
                               Margin="24,0,0,8" />

                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="Nav0" Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="True" Tag="0" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="概览" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Nav1" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="1" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="资源还原" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Nav2" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="2" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="音频" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Nav3" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="3" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="04" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="视频" />
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="20,12" />

                        <RadioButton x:Name="Nav4" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="4" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="05" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Nav5" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="5" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="06" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Opacity="0.5" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="关于" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="20,0,20,18">
                        <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,14" />
                        <TextBlock Text="仅供个人学习与研究" Style="{StaticResource Caption}" />
                        <TextBlock Text="请使用合法持有的游戏文件" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" Opacity="0.75" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= 主区域 ======================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent">
                    <TextBlock x:Name="PageTitle" Text="概览" Margin="26,0,0,0"
                               VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="最小化">
                            <Path Data="M0,0 H11" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="最大化">
                            <Path Data="M0.5,0.5 H10.5 V10.5 H0.5 Z" StrokeThickness="1.1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource ChromeCloseButton}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 页面容器：TabControl 只保留内容区，不画页签 -->
                <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent"
                            BorderThickness="0" Padding="0" Focusable="False"
                            SelectedIndex="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem><views:OverviewView /></TabItem>
                    <TabItem><views:AssetView /></TabItem>
                    <TabItem><views:AudioView /></TabItem>
                    <TabItem><views:VideoView /></TabItem>
                    <TabItem><views:SettingsView /></TabItem>
                    <TabItem><views:AboutView /></TabItem>
                </TabControl>

                <!-- 状态栏 -->
                <Border Grid.Row="2" Background="{StaticResource BgElevated}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                        Padding="26,7">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="7" Height="7"
                                     Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Margin="8,0,0,0" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Text="正在检测运行环境…" />
                        </StackPanel>
                        <TextBlock x:Name="RightText" HorizontalAlignment="Right"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
