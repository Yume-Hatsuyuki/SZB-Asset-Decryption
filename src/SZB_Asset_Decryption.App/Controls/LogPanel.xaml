<UserControl x:Class="SzbAssetDecryption.App.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SzbAssetDecryption.App.Services"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,11,12,7">
                <TextBlock Text="运行日志" Style="{StaticResource H2}" FontSize="12.5"
                           VerticalAlignment="Center" />
                <Button Content="清空" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Padding="8,3" FontSize="11.5"
                        Click="Clear_Click" />
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,0,0,6"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log, Source={x:Static svc:Workspace.Current}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,1,12,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           Style="{StaticResource LogText}" Opacity="0.55" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                           Style="{StaticResource LogText}"
                                           Foreground="{Binding LevelBrush}" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}"
                                           Style="{StaticResource LogText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
