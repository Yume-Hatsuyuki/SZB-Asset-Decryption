<UserControl x:Class="SzbTool.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,4,32,24" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="关于" Style="{StaticResource H1}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,6,0,0" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="这是什么" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="一个针对《影之诗：超凡世界》客户端资源包的分析工具。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="整个工程分成三层：Core 是可复用的解析库，Cli 是命令行，App 是现在这个界面。命令行版本做的是同一件事，适合批量和脚本化使用。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="主要功能：去除加密层、把容器拆开，让素材能交给通用工具继续处理。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="文档" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="仓库里的 docs 目录按主题拆开，建议按顺序读：术语表、容器格式、加密原理、完整解题过程、踩过的坑、清单、音频、视频、工具选型、验证方法。每一个结论都标了是怎么验证出来的。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="lessons 目录是分析期间的实验脚本，用作配套教案，不是成品软件。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="第三方组件" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="ffmpeg（视频编解码与封装，GPL 版本才带 libx264）、vgmstream（Wwise 音频解码）。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="两者都是独立程序，本工具只调用它们，不链接它们的代码。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="许可证全文见仓库的 THIRD-PARTY-NOTICES.md。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WarnBar}" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Body}" FontSize="11.5"
                           Text="仅供个人学习与研究，由此产生的任何法律纠纷由个人承担。" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
